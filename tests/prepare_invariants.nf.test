nextflow_pipeline {

    name "Test pipeline -- preparation invariants on unprepared 1000G input"
    script "../main.nf"
    tag "pipeline"

    // Runs the whole nf-prepare-vcf pipeline on a raw, messy 1000G fixture and asserts the
    // business-meaningful invariants of the preparation steps on the final reheadered VCF:
    //   BCFTOOLS_SORT -> BCFTOOLS_NORM (split multiallelics, --rm-dup) ->
    //   BCFTOOLS_ANNOTATE (strip chr prefix via rename_chr.txt, assign %CHROM_%POS_%REF_%ALT
    //   IDs) -> VEP_ANNOTATE (CSQ) -> CALC_DOSAGE_POLARSBIO (DS) -> BCFTOOLS_REHEADER (DS hdr).
    //
    // Fixture: tests/fixtures/unprepared_rand_500.vcf.gz (see tests/fixtures/README.md)
    //   - 500 variants across chr12, chr22, chrX; 35 multiallelic sites; duplicate IDs
    //   - 3202 samples (1000G high-coverage, HG00096..NA21144); per-genotype PL present
    //
    // This is the upstream home (PB5) for the NORM/ANNOTATE/VEP/dosage invariants that were
    // previously asserted only by the downstream nf-rare-var-assoc PREPARE_VCF wrapper test.
    // The -profile test sim_chr22 dataset cannot exercise these (it is already clean), so we
    // override input_vcf to the messy fixture. publish_intermediate=true so BCFTOOLS_NORM
    // publishes its tracking JSON for the count cross-check; skip_ld_report saves wall-clock.
    // Slow (VEP annotation alone takes minutes); intended for manual / nightly runs.

    test("full preparation: multiallelics split, unique CHROM_POS_REF_ALT ids, chr prefix stripped, CSQ + spec-correct DS") {

        when {
            params {
                input_vcf            = "${projectDir}/tests/fixtures/unprepared_rand_500.vcf.gz"
                project_name         = "test_prepare_invariants"
                outdir               = "$outputDir"
                publish_intermediate = true
                skip_ld_report       = true
            }
        }

        then {
            assert workflow.success

            // ---- Read the final reheadered VCF once; derive all header + body checks ----
            def vcf_lines = ["bash", "-c", "zcat ${params.outdir}/bcftools_reheader/*_reheader.vcf.gz"]
                .execute().text.split('\n') as List

            // === Header invariants =================================================

            // DS FORMAT: added by BCFTOOLS_REHEADER after CALC_DOSAGE_POLARSBIO ran.
            assert vcf_lines.any { it.startsWith('##FORMAT=<ID=DS') } :
                "output VCF must have ##FORMAT=<ID=DS,...> header line (added by BCFTOOLS_REHEADER)"

            // CSQ INFO: added by VEP_ANNOTATE. Downstream parses CSQ by field *position*, so
            // the Format field order is a contract -- assert the leading fields are in order.
            def csq_header = vcf_lines.find { it.startsWith('##INFO=<ID=CSQ') }
            assert csq_header != null :
                "output VCF must have ##INFO=<ID=CSQ,...> header line (added by VEP_ANNOTATE)"
            assert csq_header.contains('Format: Allele|Consequence|IMPACT|SYMBOL|Gene|Feature_type|Feature|BIOTYPE') :
                "CSQ header Format must begin with the field order downstream parsing relies on; got: ${csq_header}"

            // Sample-count invariant: all 3202 input samples must be preserved.
            def header_line = vcf_lines.find { it.startsWith('#CHROM') }
            assert header_line != null : "output VCF must have a #CHROM header line"
            def sample_count = header_line.split('\t').size() - 9
            assert sample_count == 3202 :
                "expected 3202 samples in output VCF, got ${sample_count}"

            // === Per-record body invariants ========================================
            // Split each row but cap at 11 fields so we keep CHROM..sample1 without splitting
            // all 3202 sample columns. Columns: 0=CHROM 1=POS 2=ID 3=REF 4=ALT 5=QUAL
            // 6=FILTER 7=INFO 8=FORMAT 9=sample1.
            def data_lines = vcf_lines.findAll { it && !it.startsWith('#') }
            def rows = data_lines.collect { it.split('\t', 11) }

            // Record-count invariant: BCFTOOLS_NORM -m -any splits multiallelics (35 such sites
            // in the fixture), so post-NORM count is >= 500.
            assert rows.size() >= 500 :
                "expected at least 500 variant records after normalization, got ${rows.size()}"

            // (1) Chromosome rename (BCFTOOLS_ANNOTATE + rename_chr.txt): the "chr" prefix must
            //     be stripped, and the fixture only spans chr12/chr22/chrX -> {12,22,X}.
            def chroms = rows.collect { it[0] }.toSet()
            assert chroms.every { !it.startsWith('chr') } :
                "all CHROM values must have the 'chr' prefix stripped (rename_chr.txt); got ${chroms}"
            assert chroms.every { it in ['12', '22', 'X'] } :
                "CHROM values must be a subset of the fixture's {12,22,X}; got ${chroms}"
            assert chroms.size() >= 2 :
                "expected multiple chromosomes carried through preparation; got ${chroms}"

            // (2) Multiallelic split (BCFTOOLS_NORM -m -any): every record must be biallelic.
            def multiallelic = rows.findAll { it[4].contains(',') }
            assert multiallelic.isEmpty() :
                "no record may carry a multiallelic ALT after NORM -m -any; offending: ${multiallelic.take(3).collect { it[2] }}"

            // (3) ID assignment (BCFTOOLS_ANNOTATE --set-id %CHROM_%POS_%REF_%ALT): each ID must
            //     reconstruct from this record's own CHROM/POS/REF/ALT, and all IDs unique.
            def bad_ids = rows.findAll { it[2] != "${it[0]}_${it[1]}_${it[3]}_${it[4]}".toString() }
            assert bad_ids.isEmpty() :
                "every ID must equal CHROM_POS_REF_ALT; offending (id vs expected): " +
                "${bad_ids.take(3).collect { [it[2], "${it[0]}_${it[1]}_${it[3]}_${it[4]}"] }}"
            def ids = rows.collect { it[2] }
            assert ids.toSet().size() == ids.size() :
                "variant IDs must all be unique after --rm-dup + set-id (duplicates break plink write-snplist)"

            // (4) VEP annotation: every *annotatable* record must carry a non-empty CSQ value.
            //     Spanning-deletion star alleles (ALT='*') emitted by NORM -m -any are not
            //     annotatable by VEP and legitimately have no CSQ -- exclude them.
            def star_rows = rows.findAll { it[4] == '*' }
            def missing_csq = rows.findAll { row ->
                if (row[4] == '*') return false
                def csq = row[7].split(';').find { it.startsWith('CSQ=') }
                csq == null || csq.substring(4).trim().isEmpty()
            }
            assert missing_csq.isEmpty() :
                "every non-star (ALT!='*') record must carry a non-empty CSQ= INFO field; " +
                "offending: ${missing_csq.take(3).collect { it[2] }}"
            assert !star_rows.isEmpty() :
                "expected some spanning-deletion star alleles (ALT='*') from NORM -m -any splitting"

            // (5) Dosage correctness (CALC_DOSAGE_POLARSBIO + BCFTOOLS_REHEADER).
            //     DS must be the last FORMAT key on every record...
            def bad_format = rows.findAll { it[8].split(':').last() != 'DS' }
            assert bad_format.isEmpty() :
                "every record's FORMAT must end with the DS key; offending: ${bad_format.take(3).collect { [it[2], it[8]] }}"

            //     ...and DS must equal the spec dosage recomputed independently of the
            //     CALC_DOSAGE implementation. Spec: L_g = 10^(-PL_g/10), normalise across
            //     genotypes, DS = P(het) + 2*P(hom_alt) (diploid, 3 PLs) or P(alt) (haploid
            //     male chrX, 2 PLs). Agreement is essentially exact; the only deviations are
            //     PL-saturation artifacts near the 255 cap, so we assert a negligible mean
            //     deviation and a tiny >0.01-violation fraction (NOT zero).
            def specDs = { plInts ->
                def ls = plInts.collect { Math.pow(10.0, -(it as double) / 10.0) }
                double tot = ls.sum() as double
                if (tot <= 0) return null
                if (plInts.size() == 3) return (ls[1] + 2.0 * ls[2]) / tot
                if (plInts.size() == 2) return ls[1] / tot
                return null
            }
            int dsChecked = 0, specViolations = 0
            double specDiffSum = 0.0, specMaxDiff = 0.0
            def specExamples = []
            data_lines.each { line ->
                def cols = line.split('\t')
                def keys = cols[8].split(':') as List
                int dsIdx = keys.indexOf('DS')
                int plIdx = keys.indexOf('PL')
                if (dsIdx < 0 || plIdx < 0) return
                for (int s = 9; s < cols.size(); s++) {
                    def sv = cols[s].split(':')
                    if (sv.size() <= Math.max(dsIdx, plIdx)) continue
                    if (!sv[dsIdx].isNumber()) continue        // DS only emitted for usable calls
                    double ds = sv[dsIdx] as double
                    def plParts = sv[plIdx].split(',')
                    if (plParts.every { it.isInteger() } && (plParts.size() in [2, 3])) {
                        def expected = specDs(plParts.collect { it.toInteger() })
                        if (expected != null) {
                            dsChecked++
                            double diff = Math.abs(ds - (expected as double))
                            specDiffSum += diff
                            if (diff > specMaxDiff) specMaxDiff = diff
                            if (diff > 0.01) {
                                specViolations++
                                if (specExamples.size() < 5)
                                    specExamples << [pos: "${cols[0]}:${cols[1]}", pl: sv[plIdx], actual: ds, spec: expected]
                            }
                        }
                    }
                }
            }
            assert dsChecked > 100000 :
                "expected to spec-check a large number of DS values, only checked ${dsChecked}"
            double specMeanDiff = specDiffSum / dsChecked
            double specViolFrac = specViolations / (double) dsChecked
            assert specMeanDiff < 1e-3 :
                "mean |DS - spec| must be negligible; got ${specMeanDiff} over ${dsChecked} genotypes"
            assert specViolFrac < 0.0005 :
                "fraction of genotypes where |DS - spec| > 0.01 must be tiny (PL-saturation tail " +
                "only); got ${specViolFrac} (${specViolations}/${dsChecked}, max diff ${specMaxDiff}), " +
                "e.g. ${specExamples}"

            // === NORM tracking cross-check =========================================
            // publish_intermediate=true -> BCFTOOLS_NORM publishes a tracking JSON. Counts must
            // line up with the fixture and the body: nothing between NORM and the final output
            // (ANNOTATE, VEP, CALC_DOSAGE, REHEADER) adds or drops records.
            def norm_json = ["bash", "-c", "cat ${params.outdir}/bcftools_norm/*_norm_tracking.json"]
                .execute().text
            def norm_tracking = new groovy.json.JsonSlurper().parseText(norm_json)
            assert (norm_tracking.inputs.variants as int) == 500 :
                "NORM tracking.inputs.variants should equal fixture count (500), got ${norm_tracking.inputs.variants}"
            assert (norm_tracking.inputs.samples as int) == 3202 :
                "NORM tracking.inputs.samples should be 3202, got ${norm_tracking.inputs.samples}"
            assert (norm_tracking.outputs.variants as int) >= 500 :
                "NORM tracking.outputs.variants should be >= 500 after multiallelic splitting, got ${norm_tracking.outputs.variants}"
            assert (norm_tracking.outputs.samples as int) == 3202 :
                "NORM tracking.outputs.samples should be 3202, got ${norm_tracking.outputs.samples}"
            assert rows.size() == (norm_tracking.outputs.variants as int) :
                "output record count (${rows.size()}) must equal NORM tracking.outputs.variants " +
                "(${norm_tracking.outputs.variants}); a mismatch means a step silently changed the record set"
        }
    }
}
