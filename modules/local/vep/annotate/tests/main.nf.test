nextflow_process {

    name "Test Process VEP_ANNOTATE"
    script "../main.nf"
    process "VEP_ANNOTATE"

    tag "modules"
    tag "modules_"
    tag "vep_annotate"

    // Consolidated tuple shape:
    //   (meta, input_vcf, input_vcf_tbi, ref_fasta, ref_fasta_index, chr_synonyms, vep_cache)
    //   + val(species) + val(input_args)
    //
    // The reference FASTA and the VEP cache live outside the repo in ${projectDir}/../vep_cachedir
    // (populated by VEP_UPDATECACHE when the pipeline runs); the same layout the pipeline uses:
    //   vep_cachedir/ref_fasta.fa(.fai)                        - GRCh38 primary reference (chr-prefixed)
    //   vep_cachedir/homo_sapiens_refseq/                      - RefSeq VEP cache (--refseq)
    //   vep_cachedir/homo_sapiens_refseq/113_GRCh38/chr_synonyms.txt - maps chr22 <-> 22
    //
    // Input fixture: tests/fixtures/unprepared_rand_500.vcf.gz (see tests/fixtures/README.md),
    // 500 raw 1000G variants on chr12/chr22/chrX -- chr-prefixed, so this also exercises
    // --synonyms.

    test("unprepared_rand_500 - vcf") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file('${projectDir}/tests/fixtures/unprepared_rand_500.vcf.gz', checkIfExists: true),
                    [],
                    file('${projectDir}/../vep_cachedir/ref_fasta.fa', checkIfExists: true),
                    file('${projectDir}/../vep_cachedir/ref_fasta.fa.fai', checkIfExists: true),
                    file('${projectDir}/../vep_cachedir/homo_sapiens_refseq/113_GRCh38/chr_synonyms.txt', checkIfExists: true),
                    file('${projectDir}/../vep_cachedir/homo_sapiens_refseq', checkIfExists: true)
                ]
                input[1] = 'homo_sapiens'
                input[2] = '--offline --no_stats --refseq --exclude_predicted --compress_output bgzip --vcf --numbers --protein --total_length --force_overwrite --format vcf --regulatory --variant_class --symbol --biotype --distance 5000 --canonical --pubmed --mane'
                """
            }
        }

        then {
            assert process.success
            assert process.out.vcf.size() == 1

            // VEP output is not byte-stable (it records the run command/date in the header),
            // so assert the annotation contract instead of an md5 snapshot.
            def vep_lines = ["bash", "-c", "zcat ${process.out.vcf[0][1]}"].execute().text.split('\n') as List

            // CSQ INFO header must be present, and downstream parses CSQ by field *position*,
            // so the leading field order is a contract.
            def csq_header = vep_lines.find { it.startsWith('##INFO=<ID=CSQ') }
            assert csq_header != null : "annotated VCF must have a ##INFO=<ID=CSQ,...> header line"
            assert csq_header.contains('Format: Allele|Consequence|IMPACT|SYMBOL|Gene|Feature_type|Feature|BIOTYPE') :
                "CSQ header Format must begin with the field order downstream parsing relies on; got: ${csq_header}"

            // All 500 fixture records must survive annotation, keeping their chr-prefixed CHROM
            // (VEP resolves chr22 -> 22 against the Ensembl cache via --synonyms but does not
            // rewrite the output).
            def rows = vep_lines.findAll { it && !it.startsWith('#') }.collect { it.split('\t', 9) }
            assert rows.size() == 500 : "expected the fixture's 500 records in the output, got ${rows.size()}"
            assert rows.collect { it[0] }.toSet().every { it.startsWith('chr') } :
                "CHROM values must be passed through unchanged; got ${rows.collect { it[0] }.toSet()}"

            // Every record must actually be annotated -- an empty CSQ everywhere is what a
            // broken --synonyms / --fasta / cache wiring looks like.
            def missing_csq = rows.findAll { row ->
                def csq = row[7].split(';').find { it.startsWith('CSQ=') }
                csq == null || csq.substring(4).trim().isEmpty()
            }
            assert missing_csq.isEmpty() :
                "every record must carry a non-empty CSQ= INFO field; offending: " +
                "${missing_csq.take(3).collect { "${it[0]}:${it[1]}" }}"

            assert snapshot(process.out.versions).match()
        }

    }

}
