nextflow_process {

    name "Test Process BCFTOOLS_REHEADER"
    script "../main.nf"
    process "BCFTOOLS_REHEADER"

    tag "modules"
    tag "bcftools"
    tag "bcftools/reheader"

    test("should replace the header produced by CALC_DOSAGE_POLARSBIO with original header with DS format field added") {

        setup {
            run("CALC_DOSAGE_POLARSBIO") {
                script "../../../python/calc_dosage_polarsbio/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test', single_end:false ], // meta map
                        file('${projectDir}/assets/chr22_filtered.vcf.gz', checkIfExists: true),
                        file('${projectDir}/modules/local/python/calc_dosage_polarsbio/assets/calc_dosage.py', checkIfExists: true)
                    ]
                    input[1] = '3'
                    input[2] = 'calc_dosage_polarsbio'
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = CALC_DOSAGE_POLARSBIO.out.vcf.map { meta, vcf_with_incorrect_header ->
                    tuple(
                        meta,
                        file('${projectDir}/assets/chr22_filtered.vcf.gz', checkIfExists: true),
                        vcf_with_incorrect_header
                    )
                }
                input[1] = '##FORMAT=<ID=DS,Number=1,Type=Float,Description="Genotype dosage (expected number of non-reference alleles)">'
                input[2] = 'reheader'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("a FORMAT/DS the original header already declares is not added a second time") {

        when {
            process {
                """
                // Both fixtures hold the same records and samples; they differ only in their
                // header. The original declares DS as Number=A, so the line offered here is
                // already there and must be dropped rather than duplicated -- bcftools rejects a
                // header that defines the same ID twice, and CALC_DOSAGE_POLARSBIO deliberately
                // keeps an input DS definition instead of replacing it with ours.
                input[0] = [
                    [ id:'test' ],
                    file('${projectDir}/tests/fixtures/dosage_cases_ds_a.vcf.gz', checkIfExists: true),
                    file('${projectDir}/tests/fixtures/dosage_cases_no_ds.vcf.gz', checkIfExists: true)
                ]
                input[1] = '##FORMAT=<ID=DS,Number=1,Type=Float,Description="Genotype dosage (expected number of non-reference alleles)">'
                input[2] = 'reheader'
                """
            }
        }

        then {
            assert process.success

            def header = ["bash", "-c", "zcat ${process.out.vcf[0][1]}"].execute().text
                .split('\n').findAll { it.startsWith('##') }

            assert header.count { it.startsWith('##FORMAT=<ID=DS,') } == 1 :
                "DS must be declared exactly once, got:\n" + header.findAll { it.startsWith('##FORMAT=<ID=DS,') }.join('\n')
            // The one kept is the original's, not the line offered to the process.
            assert header.any { it.startsWith('##FORMAT=<ID=DS,Number=A,') } :
                "the original header's own DS definition must be the one that survives"

            // Unrelated lines from the original header are still carried over.
            assert header.any { it.startsWith('##FORMAT=<ID=PL,') } :
                "the rest of the original header must be preserved"
        }

    }

}
