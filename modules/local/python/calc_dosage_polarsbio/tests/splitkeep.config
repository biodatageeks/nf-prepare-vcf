// As likelihood.config, but with the split-multiallelic cut-off raised past every PL in the
// fixture, so no genotype is dropped for it and the weighting alone decides the dosage.
process {
    withName: 'CALC_DOSAGE_POLARSBIO' {
        ext.args = '--pl-type likelihood --ds-prior-min-af 0 --ds-max-pl-min 1000'
    }
}
