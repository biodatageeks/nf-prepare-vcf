/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run psuszyns/nf-prepare-vcf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '36.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Raw, chr-prefixed 1000G fixture (500 variants on chr12/chr22/chrX, 3202 samples).
    // BCFTOOLS_NORM left-aligns against the chr-prefixed GRCh38 reference, so the input VCF
    // must be chr-prefixed too -- the "chr" prefix is only stripped later, in BCFTOOLS_ANNOTATE.
    input_vcf         = "${projectDir}/tests/fixtures/unprepared_rand_500.vcf.gz"
    project_name      = "test_rand_500"
    outdir            = "results"
    compute_ld_report = true
}
