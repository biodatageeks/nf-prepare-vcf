/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        enabled: params.publish_intermediate,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'BCFTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/bcftools_index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = '-t'
    }

    withName: 'BCFTOOLS_NORM' {
        publishDir = [
            path: { "${params.outdir}/bcftools_norm" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = '--rm-dup exact -m -any --keep-sum AD --output-type z --write-index=tbi'
    }

    withName: 'BCFTOOLS_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/bcftools_annotate" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "--set-id '%CHROM\\_%POS\\_%REF\\_%ALT' --output-type z --write-index=tbi"
    }

    withName: 'BCFTOOLS_VCF2PSAM' {
        publishDir = [
            path: { "${params.outdir}/bcftools_vcf2psam" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BCFTOOLS_SORT' {
        publishDir = [
            path: { "${params.outdir}/bcftools_sort" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "--output-type z --write-index=tbi"
    }

    withName: 'BCFTOOLS_REHEADER' {
        publishDir = [
            path: { "${params.outdir}/bcftools_reheader" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VEP_UPDATECACHE' {
        publishDir = [
            path: { "${params.outdir}/vep_updatecache" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') || filename.startsWith('vep_cachedir') ? null : filename }
        ]
    }

    withName: 'VEP_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/vep_annotate" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COMPUTE_GENE_RANGES' {
        publishDir = [
            path: { "${params.outdir}/compute_gene_ranges" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLINK2_MAKEPGEN' {
        publishDir = [
            path: { "${params.outdir}/plink2_makepgen" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLINK2_LD_REPORT' {
        publishDir = [
            path: { "${params.outdir}/plink2_ld_report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CALC_DOSAGE_POLARSBIO' {
        publishDir = [
            path: { "${params.outdir}/calc_dosage_polarsbio" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
